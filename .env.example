# OpenAI (or compatible) key used for the chat model
LLM_API_KEY=

# OpenAI (or compatible) key used for Whisper speech-to-text
STT_API_KEY=

# Google Cloud project for Text-to-Speech + Firestore + Auth token verification
GOOGLE_CLOUD_PROJECT_ID=

# Absolute path to a Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: inline JSON for the service account (alternative to the file path)
# GOOGLE_CLOUD_CREDENTIALS_JSON=

# Optional canonical site URL for Open Graph / metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Stripe billing (test or live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional client-side copy of the publishable key (needed only if you use Stripe.js / Elements)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Display-only price label on the landing page
# NEXT_PUBLIC_STRIPE_PRICE_LABEL=\$15
# Free daily practice minutes without a subscription (default 15)
# FREE_DAILY_MINUTES=15
# NEXT_PUBLIC_FREE_DAILY_MINUTES=15

# Firebase Web SDK (public client config — safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional overrides
# LLM_MODEL=gpt-4o-mini
# TTS_VOICE_NAME=es-ES-Neural2-B

# Analytics (optional — leave blank to skip)
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
# If you also fire GA4 from inside GTM, leave this empty to avoid double-counting.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
